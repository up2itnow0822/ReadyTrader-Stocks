# Example Environment Variables for ReadyTrader-Stocks
# Copy to .env (git-ignored). Paper mode needs none of the keys below.

# --- Mode & Safety ---
PAPER_MODE=true
# Live orders need PAPER_MODE=false AND LIVE_TRADING_ENABLED=true; TRADING_HALTED=true stops them.
LIVE_TRADING_ENABLED=false
# auto executes orders directly; approve_each (or any value other than auto) makes every order a
# proposal a human approves. Keep comments on their own line: docker --env-file does not strip them.
EXECUTION_APPROVAL_MODE=auto
TRADING_HALTED=false
# Read but not applied yet (kept so existing configurations load): the Risk Guardian limits
# are fixed. RISK_PROFILE, EXECUTION_MODE and RATE_LIMIT_DEFAULT_PER_MIN change nothing today.
# RISK_PROFILE=conservative
# EXECUTION_MODE=auto
# Optional policy limits for live brokerage orders (unset = no limit / all allowed):
# MAX_ORDER_AMOUNT=100
# ALLOW_TICKERS=AAPL,MSFT,SPY
# ALLOW_BROKERAGES=alpaca,tradier

# --- Approvals across processes (approve_each) ---
# The MCP server and the API server (python app/api_server.py) share proposals when both are
# given the same EXECUTION_DB_PATH and EXECUTION_SESSION_ID. Approving still needs the proposal's
# confirm_token, which the agent receives when it places the order.
# EXECUTION_DB_PATH=data/execution.db
# EXECUTION_SESSION_ID=my-desk

# --- Market guard: Falling Knife (price) - docs/FALLING_KNIFE.md ---
# On by default. Every BUY reads recent daily bars (one cached fetch per symbol per minute).
# Only false/0/no/off turns it off; any other value (a typo included) leaves it on.
MARKET_GUARD_ENABLED=true
# What a BUY does when the daily bars cannot be read: block | allow.
# Leave unset to block in live mode and allow (flagged in the response) in paper mode.
# MARKET_GUARD_ON_DATA_ERROR=block
# The session the "no bar yet for today" check uses:
# MARKET_TIMEZONE=US/Eastern
# MARKET_HOURS_START=09:30
# MARKET_HOURS_END=16:00
# CIRCUIT_BREAKER_PCT is read for backward compatibility but no check uses it.

# --- Brokerage Credentials (Stock Focus) ---
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# Live Alpaca orders go to your Alpaca PAPER account unless ALPACA_PAPER is false/0/no/off.
# ALPACA_PAPER=true
# TRADIER_ACCESS_TOKEN=
# TRADIER_ACCOUNT_ID=
# Tradier uses its sandbox unless TRADIER_SANDBOX is false/0/no/off.
# TRADIER_SANDBOX=true
# Interactive Brokers (TWS / IB Gateway):
# IBKR_ENABLED=false
# IBKR_HOST=127.0.0.1
# IBKR_PORT=7497
# IBKR_CLIENT_ID=1
# E*TRADE, Schwab and Robinhood adapters (experimental):
# ETRADE_CONSUMER_KEY=
# ETRADE_CONSUMER_SECRET=
# ETRADE_RESOURCE_OWNER_KEY=
# ETRADE_RESOURCE_OWNER_SECRET=
# ETRADE_ACCOUNT_ID_KEY=
# E*TRADE uses production unless ETRADE_SANDBOX is true/1/yes/on (orders and balances alike).
# ETRADE_SANDBOX=true
# SCHWAB_ACCESS_TOKEN=
# SCHWAB_ACCOUNT_HASH=
# SCHWAB_BASE_URL=https://api.schwabapi.com/trader/v1
# ROBINHOOD_USER=
# ROBINHOOD_PASS=
# ROBINHOOD_TOTP=
# Retries for brokerage calls:
# BROKERAGE_RETRY_MAX_ATTEMPTS=3
# BROKERAGE_RETRY_BASE_DELAY_SEC=0.5
# BROKERAGE_RETRY_MAX_DELAY_SEC=5

# --- Market Data (yfinance, no key needed) ---
# TICKER_CACHE_TTL_SEC=5
# OHLCV_CACHE_TTL_SEC=60
# MARKETDATA_FAIL_CLOSED=false
# MARKETDATA_MAX_AGE_MS=30000
# MARKETDATA_OUTLIER_MAX_PCT=20
# MARKETDATA_OUTLIER_WINDOW_MS=10000
# MARKETDATA_PROVIDER_PRIORITY_JSON=
# MARKETDATA_PLUGINS_JSON=

# --- Market Data & Intelligence ---
# For get_financial_news
# NEWSAPI_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# X posts for get_social_sentiment:
# TWITTER_BEARER_TOKEN=
# get_market_news:
# ALPHAVANTAGE_API_KEY=

# --- Notifications (approve_each) ---
# DISCORD_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Storage (SQLite; each also accepts a READYTRADER_ prefix) ---
# Files live in <repo>/data/ whatever folder the MCP client starts the server in; move them all
# with READYTRADER_DATA_DIR, or one at a time with the *_PATH variables below.
# READYTRADER_DATA_DIR=
# PAPER_DB_PATH=data/paper.db
# INSIGHT_DB_PATH=data/insights.db
# STRATEGY_DB_PATH=data/strategies.db
# AUDIT_DB_PATH=
# IDEMPOTENCY_DB_PATH=

# --- Server Configuration ---
API_PORT=8000
# API_HOST=127.0.0.1
# Browser origins allowed to call the API (the dashboard). "*" is ignored.
# API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Operator secret for the API server only (never give it to the MCP server): required for every
# /api/ call but /api/health, and for approving live proposals.
# API_OPERATOR_TOKEN=
LOG_LEVEL=INFO
# READYTRADER_LOG_LEVEL=INFO
# READYTRADER_SERVICE_NAME=readytrader-stocks
# RATE_LIMIT_DEFAULT_PER_MIN=120
